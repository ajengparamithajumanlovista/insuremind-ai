APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# SQLite file location. Leave empty locally to use database/database.sqlite.
# On Railway (Volume mounted at /data) set: DB_DATABASE=/data/database.sqlite
DB_DATABASE=
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
#DB_DATABASE=insuremind_ai
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave empty (null) in production unless the site is accessed through a specific subdomain.
SESSION_DOMAIN=null
# Set to "true" only when the site is accessed over HTTPS (e.g. Railway).
SESSION_SECURE_COOKIE=
# "lax" is safe for a single-domain application; use "none" only when cross-site access is needed.
SESSION_SAME_SITE=lax

# Behind a reverse proxy (Railway/Heroku), let Laravel trust the X-Forwarded-*
# headers so sessions and HTTPS URLs work correctly.
# TRUSTED_PROXIES=*

# ─── AI assistant ───────────────────────────────────────────────────────────
# Provider names are read on the SERVER only; never use a VITE_ prefix, or the
# values would be compiled into browser JavaScript.
#
# Primary provider: groq | gemini. Fallback: groq | gemini | none.
# The fallback is used only for non-retryable failures (bad key, unknown model,
# spent quota) so a brief outage on one provider does not burn the other's quota.
AI_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini
AI_TIMEOUT=30
AI_HISTORY_LIMIT=12
AI_MAX_OUTPUT_TOKENS=1024
AI_TEMPERATURE=0.7
AI_RETRY_ATTEMPTS=2
AI_RETRY_MAX_DELAY=20

# Groq (free tier, no billing). Create a key at https://console.groq.com/keys
# and leave GROQ_API_KEY empty in this file: real keys belong in .env only.
GROQ_API_KEY= 
# Must be a model id your key can use (GET /openai/v1/models lists them).
# Groq recommends openai/gpt-oss-20b as the replacement for the retired
# llama-3.1-8b-instant model.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=[https://api.groq.com/openai/v1](https://api.groq.com/openai/v1)
# Only for reasoning models such as openai/gpt-oss-20b: low | medium | high.
GROQ_REASONING_EFFORT=

# AI assistant — Google Gemini (optional provider / fallback; server-side only).
# Create a key at https://aistudio.google.com/apikey and keep it out of git.
GEMINI_API_KEY=
# Must be a model returned by GET /v1beta/models for YOUR key. The free tier is
# small (a handful of requests per minute, a few dozen per day), so the default
# below is the cheapest current model. Retired models answer 404 NOT_FOUND.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_VERSION=v1beta
GEMINI_BASE_URL=[https://generativelanguage.googleapis.com](https://generativelanguage.googleapis.com)
GEMINI_TIMEOUT=30
GEMINI_HISTORY_LIMIT=12
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.7
GEMINI_THINKING_BUDGET=0
# Transient-error handling: one retry, never when Google asks to wait longer
# than this many seconds (a spent daily quota is never retried).
GEMINI_RETRY_ATTEMPTS=2
GEMINI_RETRY_MAX_DELAY=20

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# User-uploaded policy documents. On Railway point the root at the volume:
#   DOCUMENTS_DISK=documents
#   DOCUMENTS_DISK_ROOT=/data/storage/documents
DOCUMENTS_DISK=documents
# DOCUMENTS_DISK_ROOT=/data/storage/documents

# Persistent root for uploads (mounted Railway Volume).
DATA_ROOT=/data

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
