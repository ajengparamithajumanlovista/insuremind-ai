APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# SQLite file location. Leave empty locally to use database/database.sqlite.
# On Railway (Volume mounted at /data) set: DB_DATABASE=/data/database.sqlite
DB_DATABASE=
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
#DB_DATABASE=insuremind_ai
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Leave empty (null) in production unless the site is accessed through a specific subdomain.
SESSION_DOMAIN=null
# Set to "true" only when the site is accessed over HTTPS (e.g. Railway).
SESSION_SECURE_COOKIE=
# "lax" is safe for a single-domain application; use "none" only when cross-site access is needed.
SESSION_SAME_SITE=lax

# Behind a reverse proxy (Railway/Heroku), let Laravel trust the X-Forwarded-*
# headers so sessions and HTTPS URLs work correctly.
# TRUSTED_PROXIES=*

# AI assistant (optional). If OPENAI_API_KEY is empty, the chatbot
# automatically uses a rule-based answer engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=20

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# User-uploaded policy documents. On Railway point the root at the volume:
#   DOCUMENTS_DISK=documents
#   DOCUMENTS_DISK_ROOT=/data/storage/documents
DOCUMENTS_DISK=documents
# DOCUMENTS_DISK_ROOT=/data/storage/documents

# Persistent root for uploads (mounted Railway Volume).
DATA_ROOT=/data

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
